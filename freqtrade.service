[Unit]
Description=Forex Trading API
After=network.target

[Service]
# This is a user service. %h resolves to /home/<username>.
WorkingDirectory=%h/forex_bot
ExecStart=%h/forex_bot/.venv/bin/python -m uvicorn freqtrade.forex.api:app --host 0.0.0.0 --port 8090
Restart=on-failure

[Install]
WantedBy=default.target
